# Copie para .env.local e preencha. Nunca versione valores reais.

# Conexão Postgres do Supabase
DATABASE_URL=

# Segredo do JWT: ao menos 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
JWT_SECRET=

# Só para scripts/criar-admin.mjs. Remova do .env.local depois de usar.
ADMIN_EMAIL=
ADMIN_SENHA=
