# Copie para .env.local e preencha. Nunca versione valores reais.

# Conexão Postgres do Supabase
DATABASE_URL=

# Segredo do JWT: ao menos 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
JWT_SECRET=

# Endereço público do site, usado nos links enviados por e-mail.
# Na Vercel, se ficar vazio, usa o domínio de produção do projeto.
APP_URL=

# E-mail de "Esqueci minha senha" (SMTP). Sem estes valores o e-mail não é enviado.
# Exemplo com Gmail: smtp.gmail.com, porta 465, SMTP_SECURE=true, usuário = o e-mail
# e senha = uma "senha de app" (nunca a senha da conta).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Só para scripts/criar-admin.mjs. Remova do .env.local depois de usar.
ADMIN_EMAIL=
ADMIN_SENHA=
