@@ -0,0 +1,55 @@
+import { NextResponse } from "next/server";
+
+import { autorizar, autorizarOpcional } from "@/lib/server/auth/guard";
+import { listarPublicos } from "@/lib/server/db/usuarios";
+import { lerJson, registrarErro, respostaErro } from "@/lib/server/http";
+import { criarConta } from "@/lib/server/services/auth";
+import {
+  camposDoErro,
+  criarUsuarioSchema,
+} from "@/lib/server/validation/usuarios";
+
+// Cadastro de conta. Pública para contas de mesário (com CPF e título de um
+// cadastro existente); qualquer outro papel exige um administrador.
+export async function POST(request: Request) {
+  const entrada = criarUsuarioSchema.safeParse(await lerJson(request));
+  if (!entrada.success) {
+    return respostaErro(400, "Dados inválidos", {
+      campos: camposDoErro(entrada.error),
+    });
+  }
+
+  try {
+    const chamador = await autorizarOpcional(request);
+    if (!chamador.ok) {
+      return chamador.resposta;
+    }
+
+    const resultado = await criarConta(entrada.data, chamador.usuario);
+    if (!resultado.ok) {
+      return respostaErro(resultado.status, resultado.erro, {
+        campos: resultado.campos,
+      });
+    }
+
+    return NextResponse.json({ usuario: resultado.usuario }, { status: 201 });
+  } catch (erro) {
+    registrarErro("criar-usuario", erro);
+    return respostaErro(500, "Erro interno");
+  }
+}
+
+// Lista as contas. Só administrador.
+export async function GET(request: Request) {
+  try {
+    const acesso = await autorizar(request, { papeis: ["administrador"] });
+    if (!acesso.ok) {
+      return acesso.resposta;
+    }
+
+    return NextResponse.json({ usuarios: await listarPublicos() });
+  } catch (erro) {
+    registrarErro("listar-usuarios", erro);
+    return respostaErro(500, "Erro interno");
+  }
+}
diff --git a/lib/server/auth/guard.ts b/lib/server/auth/guard.ts
new file mode 100644
index 0000000..9ba71c6
--- /dev/null
+++ b/lib/server/auth/guard.ts
@@ -0,0 +1,74 @@
+import type { NextResponse } from "next/server";
+
+import { buscarPublicoPorId } from "@/lib/server/db/usuarios";
+import { respostaErro } from "@/lib/server/http";
+
+import type { Papel, UsuarioPublico } from "./tipos";
+import { verificarToken } from "./token";
+
+export type ResultadoAutorizacao =
+  | { ok: true; usuario: UsuarioPublico }
+  | { ok: false; resposta: NextResponse };
+
+export type ResultadoAutorizacaoOpcional =
+  | { ok: true; usuario: UsuarioPublico | null }
+  | { ok: false; resposta: NextResponse };
+
+function naoAutenticado(mensagem: string): {
+  ok: false;
+  resposta: NextResponse;
+} {
+  return {
+    ok: false,
+    resposta: respostaErro(401, mensagem, {
+      headers: { "WWW-Authenticate": "Bearer" },
+    }),
+  };
+}
+
+async function usuarioDoToken(
+  cabecalho: string,
+): Promise<UsuarioPublico | null> {
+  const partes = /^Bearer\s+(\S+)$/i.exec(cabecalho.trim());
+  const id = partes ? await verificarToken(partes[1]) : null;
+  return id === null ? null : buscarPublicoPorId(id);
+}
+
+/**
+ * Exige token válido (401 se faltar, for inválido ou tiver expirado) e,
+ * se informado, um dos papéis permitidos (403 se o papel não bastar).
+ * O papel vem do banco a cada requisição, não do token.
+ */
+export async function autorizar(
+  request: Request,
+  opcoes: { papeis?: readonly Papel[] } = {},
+): Promise<ResultadoAutorizacao> {
+  const cabecalho = request.headers.get("authorization");
+  if (!cabecalho) {
+    return naoAutenticado("Autenticação necessária");
+  }
+
+  const usuario = await usuarioDoToken(cabecalho);
+  if (!usuario) {
+    return naoAutenticado("Token inválido ou expirado");
+  }
+
+  if (opcoes.papeis && !opcoes.papeis.includes(usuario.papel)) {
+    return {
+      ok: false,
+      resposta: respostaErro(403, "Sem permissão para esta ação"),
+    };
+  }
+
+  return { ok: true, usuario };
+}
+
+/** Como autorizar, mas sem token a requisição segue como anônima. Token presente e inválido continua sendo 401. */
+export async function autorizarOpcional(
+  request: Request,
+): Promise<ResultadoAutorizacaoOpcional> {
+  if (!request.headers.get("authorization")) {
+    return { ok: true, usuario: null };
+  }
+  return autorizar(request);
+}
