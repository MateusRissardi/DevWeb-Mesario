+export const PAPEIS = ["mesario", "cartorio", "administrador"] as const;
+
+export type Papel = (typeof PAPEIS)[number];
+
+/** Dados da conta que podem sair do servidor. Nunca inclui a senha nem o hash. */
+export interface UsuarioPublico {
+  id: number;
+  email: string;
+  papel: Papel;
+  mesario_id: number | null;
+  criado_em: Date;
+}
diff --git a/lib/server/auth/token.ts b/lib/server/auth/token.ts
new file mode 100644
index 0000000..906b5aa
--- /dev/null
+++ b/lib/server/auth/token.ts
@@ -0,0 +1,41 @@
+import { SignJWT, jwtVerify } from "jose";
+
+const EXPIRACAO_SEGUNDOS = 60 * 60;
+const EMISSOR = "portal-mesario";
+
+function segredo(): Uint8Array {
+  const valor = process.env.JWT_SECRET;
+  if (!valor || valor.length < 32) {
+    throw new Error("JWT_SECRET ausente ou com menos de 32 caracteres");
+  }
+  return new TextEncoder().encode(valor);
+}
+
+export async function criarToken(usuarioId: number) {
+  const expiraEm = Math.floor(Date.now() / 1000) + EXPIRACAO_SEGUNDOS;
+  const token = await new SignJWT({})
+    .setProtectedHeader({ alg: "HS256" })
+    .setSubject(String(usuarioId))
+    .setIssuer(EMISSOR)
+    .setIssuedAt()
+    .setExpirationTime(expiraEm)
+    .sign(segredo());
+
+  return { token, expiraEm: new Date(expiraEm * 1000).toISOString() };
+}
+
+/** Devolve o id do usuário se o token for válido e não tiver expirado; senão, null. */
+export async function verificarToken(token: string): Promise<number | null> {
+  const chave = segredo();
+
+  try {
+    const { payload } = await jwtVerify(token, chave, {
+      algorithms: ["HS256"],
+      issuer: EMISSOR,
+    });
+    const id = Number(payload.sub);
+    return Number.isInteger(id) && id > 0 ? id : null;
+  } catch {
+    return null;
+  }
+}
diff --git a/lib/server/db/usuarios.ts b/lib/server/db/usuarios.ts
new file mode 100644
index 0000000..64401dd
--- /dev/null
+++ b/lib/server/db/usuarios.ts
@@ -0,0 +1,96 @@
+import pool from "@/lib/db";
+import type { Papel, UsuarioPublico } from "@/lib/server/auth/tipos";
+
+export interface UsuarioComHash extends UsuarioPublico {
+  senha_hash: string;
+}
+
+const COLUNAS_PUBLICAS = "id, email, papel, mesario_id, criado_em";
+
+export async function buscarPorEmail(
+  email: string,
+): Promise<UsuarioComHash | null> {
+  const resultado = await pool.query<UsuarioComHash>(
+    `SELECT ${COLUNAS_PUBLICAS}, senha_hash FROM usuarios WHERE email = $1`,
+    [email],
+  );
+  return resultado.rows[0] ?? null;
+}
+
+export async function buscarPublicoPorId(
+  id: number,
+): Promise<UsuarioPublico | null> {
+  const resultado = await pool.query<UsuarioPublico>(
+    `SELECT ${COLUNAS_PUBLICAS} FROM usuarios WHERE id = $1`,
+    [id],
+  );
+  return resultado.rows[0] ?? null;
+}
+
+export async function listarPublicos(): Promise<UsuarioPublico[]> {
+  const resultado = await pool.query<UsuarioPublico>(
+    `SELECT ${COLUNAS_PUBLICAS} FROM usuarios ORDER BY id`,
+  );
+  return resultado.rows;
+}
+
+export async function buscarMesarioId(
+  cpf: string,
+  tituloEleitor: string,
+): Promise<number | null> {
+  const resultado = await pool.query<{ id: number }>(
+    "SELECT id FROM mesarios WHERE cpf = $1 AND titulo_eleitor = $2",
+    [cpf, tituloEleitor],
+  );
+  return resultado.rows[0]?.id ?? null;
+}
+
+export async function inserirUsuario(dados: {
+  email: string;
+  senhaHash: string;
+  papel: Papel;
+  mesarioId: number | null;
+}): Promise<UsuarioPublico> {
+  const resultado = await pool.query<UsuarioPublico>(
+    `INSERT INTO usuarios (email, senha_hash, papel, mesario_id)
+     VALUES ($1, $2, $3, $4)
+     RETURNING ${COLUNAS_PUBLICAS}`,
+    [dados.email, dados.senhaHash, dados.papel, dados.mesarioId],
+  );
+  return resultado.rows[0];
+}
+
+export async function contarFalhasRecentes(
+  email: string,
+  ip: string | null,
+  janelaMinutos: number,
+): Promise<{ porEmail: number; porIp: number }> {
+  const resultado = await pool.query<{ por_email: string; por_ip: string }>(
+    `SELECT
+       count(*) FILTER (WHERE email = $1) AS por_email,
+       count(*) FILTER (WHERE $2::varchar IS NOT NULL AND ip = $2) AS por_ip
+     FROM tentativas_login
+     WHERE criada_em > now() - make_interval(mins => $3)`,
+    [email, ip, janelaMinutos],
+  );
+  const linha = resultado.rows[0];
+  return { porEmail: Number(linha.por_email), porIp: Number(linha.por_ip) };
+}
+
+export async function registrarFalha(
+  email: string,
+  ip: string | null,
+): Promise<void> {
+  await pool.query(
+    "INSERT INTO tentativas_login (email, ip) VALUES ($1, $2)",
+    [email, ip],
+  );
+  // Limpeza oportunista: falhas com mais de um dia não servem mais.
+  await pool.query(
+    "DELETE FROM tentativas_login WHERE criada_em < now() - interval '1 day'",
+  );
+}
+
+export async function limparFalhas(email: string): Promise<void> {
+  await pool.query("DELETE FROM tentativas_login WHERE email = $1", [email]);
+}
diff --git a/lib/server/http.ts b/lib/server/http.ts
new file mode 100644
index 0000000..e80cabc
--- /dev/null
+++ b/lib/server/http.ts
@@ -0,0 +1,43 @@
+import { NextResponse } from "next/server";
+
+export type CamposInvalidos = Record<string, string>;
+
+/** Resposta de erro no formato { erro, campos? } usado pelas rotas novas. */
+export function respostaErro(
+  status: number,
+  erro: string,
+  opcoes: { campos?: CamposInvalidos; headers?: HeadersInit } = {},
+) {
+  return NextResponse.json(
+    opcoes.campos ? { erro, campos: opcoes.campos } : { erro },
+    { status, headers: opcoes.headers },
+  );
+}
+
+/** Lê o corpo JSON. Devolve undefined se o corpo não for JSON válido. */
+export async function lerJson(request: Request): Promise<unknown> {
+  try {
+    return await request.json();
+  } catch {
+    return undefined;
+  }
+}
+
+/** IP do cliente. Na Vercel, o primeiro item de x-forwarded-for é o do cliente. */
+export function ipDaRequisicao(request: Request): string | null {
+  const encaminhado = request.headers.get("x-forwarded-for");
+  const ip = encaminhado?.split(",")[0]?.trim() || request.headers.get("x-real-ip");
+  return ip ? ip.slice(0, 45) : null;
+}
+
+/** Registra só o tipo e a mensagem do erro, nunca o corpo da requisição. */
+export function registrarErro(contexto: string, erro: unknown) {
+  if (erro instanceof Error) {
+    const codigo = (erro as { code?: unknown }).code;
+    console.error(
+      `[${contexto}] ${erro.name}${typeof codigo === "string" ? ` (${codigo})` : ""}: ${erro.message}`,
+    );
+    return;
+  }
+  console.error(`[${contexto}] erro desconhecido`);
+}
diff --git a/lib/server/services/auth.ts b/lib/server/services/auth.ts
new file mode 100644
index 0000000..bb29cbf
--- /dev/null
+++ b/lib/server/services/auth.ts
@@ -0,0 +1,143 @@
+import type { Papel, UsuarioPublico } from "@/lib/server/auth/tipos";
+import { conferirSenha, gerarHash } from "@/lib/server/auth/senha";
+import { criarToken } from "@/lib/server/auth/token";
+import {
+  buscarMesarioId,
+  buscarPorEmail,
+  contarFalhasRecentes,
+  inserirUsuario,
+  limparFalhas,
+  registrarFalha,
+} from "@/lib/server/db/usuarios";
+import type { CamposInvalidos } from "@/lib/server/http";
+import type { CriarUsuarioEntrada } from "@/lib/server/validation/usuarios";
+
+const JANELA_MINUTOS = 15;
+const MAX_FALHAS_POR_EMAIL = 5;
+const MAX_FALHAS_POR_IP = 20;
+
+export interface Falha {
+  ok: false;
+  status: number;
+  erro: string;
+  campos?: CamposInvalidos;
+  retryAfterSegundos?: number;
+}
+
+/**
+ * Cria uma conta. Sem token, só nasce conta de mesário, ligada a um cadastro
+ * existente por CPF e título. Outros papéis exigem um administrador.
+ */
+export async function criarConta(
+  entrada: CriarUsuarioEntrada,
+  chamador: UsuarioPublico | null,
+): Promise<{ ok: true; usuario: UsuarioPublico } | Falha> {
+  const papel: Papel = entrada.papel ?? "mesario";
+
+  if (papel !== "mesario") {
+    if (!chamador) {
+      return {
+        ok: false,
+        status: 401,
+        erro: "Autenticação necessária para criar este tipo de conta",
+      };
+    }
+    if (chamador.papel !== "administrador") {
+      return {
+        ok: false,
+        status: 403,
+        erro: "Sem permissão para criar este tipo de conta",
+      };
+    }
+  }
+
+  let mesarioId: number | null = null;
+  const { cpf, titulo_eleitor: titulo } = entrada;
+
+  if (papel === "mesario" && (cpf || titulo || !chamador)) {
+    const campos: CamposInvalidos = {};
+    if (!cpf) campos.cpf = "Informe o CPF";
+    if (!titulo) campos.titulo_eleitor = "Informe o título de eleitor";
+    if (Object.keys(campos).length > 0 || !cpf || !titulo) {
+      return { ok: false, status: 400, erro: "Dados inválidos", campos };
+    }
+
+    mesarioId = await buscarMesarioId(cpf, titulo);
+    if (mesarioId === null) {
+      return {
+        ok: false,
+        status: 400,
+        erro: "Dados inválidos",
+        campos: { cadastro: "Nenhum cadastro encontrado com esses dados" },
+      };
+    }
+  }
+
+  const senhaHash = await gerarHash(entrada.senha);
+
+  try {
+    const usuario = await inserirUsuario({
+      email: entrada.email,
+      senhaHash,
+      papel,
+      mesarioId,
+    });
+    return { ok: true, usuario };
+  } catch (erro) {
+    const { code, constraint } = erro as { code?: string; constraint?: string };
+    if (code === "23505") {
+      return {
+        ok: false,
+        status: 409,
+        erro:
+          constraint === "usuarios_mesario_id_key"
+            ? "Já existe uma conta para este cadastro"
+            : "E-mail já cadastrado",
+      };
+    }
+    throw erro;
+  }
+}
+
+/** Confere e-mail e senha. A mensagem de falha é a mesma para e-mail inexistente e senha errada. */
+export async function autenticar(
+  email: string,
+  senha: string,
+  ip: string | null,
+): Promise<
+  | {
+      ok: true;
+      token: string;
+      expiraEm: string;
+      usuario: UsuarioPublico;
+    }
+  | Falha
+> {
+  const falhas = await contarFalhasRecentes(email, ip, JANELA_MINUTOS);
+  if (
+    falhas.porEmail >= MAX_FALHAS_POR_EMAIL ||
+    falhas.porIp >= MAX_FALHAS_POR_IP
+  ) {
+    return {
+      ok: false,
+      status: 429,
+      erro: "Muitas tentativas. Tente novamente mais tarde",
+      retryAfterSegundos: JANELA_MINUTOS * 60,
+    };
+  }
+
+  const registro = await buscarPorEmail(email);
+  const confere = await conferirSenha(senha, registro?.senha_hash);
+
+  if (!registro || !confere) {
+    await registrarFalha(email, ip);
+    return { ok: false, status: 401, erro: "E-mail ou senha inválidos" };
+  }
+
+  await limparFalhas(email);
+  const { token, expiraEm } = await criarToken(registro.id);
+  const { senha_hash: _descartado, ...usuario } = registro;
+  void _descartado;
+
+  return { ok: true, token, expiraEm, usuario };
+}
diff --git a/lib/server/validation/usuarios.ts b/lib/server/validation/usuarios.ts
